#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:183
msgid "Common Errors and How to Avoid Them"
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:185
msgid "**Error: Kubernetes API not reachable**"
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:187
msgid ""
"*Cause:* API endpoint is private and you're not connected to the VCN via "
"VPN or Bastion."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:188
msgid ""
"*Solution:* Ensure you have access to the network or make the endpoint "
"public for testing."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:190
msgid "**Error: Stack creation fails with missing permissions**"
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:192
msgid "*Cause:* IAM policies are not set properly for the user or group."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:193
msgid ""
"*Solution:* Ensure you have permissions for Resource Manager, OKE, "
"Networking, and Secrets."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:195
msgid "**Error: No ingress returned by kubectl**"
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:197
msgid "*Cause:* Mattermost Ingress might not be ready or was misconfigured."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:198
msgid ""
"*Solution:* Check with ``kubectl describe ingress`` and validate DNS, "
"TLS, and Helm values."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:200
msgid "**Error: PostgreSQL password rejected**"
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:202
msgid "*Cause:* Password not set or mismatched with Oracle Vault."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:203
msgid "*Solution:* Re-check the password value or Vault secret used during setup."
msgstr ""

