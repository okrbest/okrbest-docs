#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:187
msgid ""
"*Solution:* Ensure you have access to the network or make the endpoint "
"public for testing."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:189
msgid "**Error: Stack creation fails with missing permissions**"
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:191
msgid "*Cause:* IAM policies are not set properly for the user or group."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:192
msgid ""
"*Solution:* Ensure you have permissions for Resource Manager, OKE, "
"Networking, and Secrets."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:194
msgid "**Error: No ingress returned by kubectl**"
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:196
msgid "*Cause:* Mattermost Ingress might not be ready or was misconfigured."
msgstr ""

#: ../../source/deployment-guide/server/kubernetes/deploy-k8s-oke.rst:197
msgid ""
"*Solution:* Check with ``kubectl describe ingress`` and validate DNS, "
"TLS, and Helm values."
msgstr ""

