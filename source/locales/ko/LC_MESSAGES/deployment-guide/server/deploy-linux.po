msgid ""
"**Mattermost version:** The Mattermost version to install (for example, "
"``11.6.2``). See the :doc:`Mattermost release policy </product-overview"
"/release-policy>` for supported versions."
msgstr ""

#: ../../source/deployment-guide/server/linux/deploy-azure-native-vm.rst:60
msgid "An example of the Azure Native Application setup screen."
msgstr ""

#: ../../source/deployment-guide/server/linux/deploy-azure-native-vm.rst:64
msgid "Step 4: Database"
