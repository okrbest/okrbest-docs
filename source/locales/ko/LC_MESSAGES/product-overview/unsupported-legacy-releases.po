#: ../../source/product-overview/unsupported-legacy-releases.md:12606
#: ../../source/product-overview/unsupported-legacy-releases.md:14443
msgid "Slash Commands"
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8444
msgid ""
"Added support for sending a message to a different channel than where the"
" slash command was issued from."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8445
msgid ""
"Added an option to send a message beginning with a \"/\" from the right-"
"hand side."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8448
msgid ""
"Added server support for updating a plugin instead of having to remove "
"and install them as two separate actions."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8450
msgid "Attachments"
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8451
msgid "Optimized file attachment memory usage where possible."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8455
msgid ""
"Fixed an issue where \"[user] is typing ...\" was not removed when a "
"message was composed and sent very quickly."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8456
msgid ""
"Fixed an issue where an announcement banner displayed when the banner was"
" enabled but the text field was blank."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8457
msgid ""
"Fixed an issue where a language was not set if selected in Account "
"Settings."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8458
msgid ""
"Fixed an issue where removing rows from Send Email Invite modal didn't "
"remove them immediately."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:8467
msgid ""
"Added ``\"ExperimentalLdapGroupSync\": false``, to add support for "
"experimental LDAP Group Sync feature."
msgstr ""

