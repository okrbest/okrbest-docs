msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:2064
msgid "Added a new API endpoint ``GET api/v4/posts/[POST_ID]/edit_history``."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:2065
msgid "Added a new API endpoint ``DELETE /api/v4/cloud/delete-workspace``."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:2068
msgid "Added the ``SentAt`` column to ``NotifyAdmin``."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:2069
