msgid ""
"Multiple setting options were added to `config.json`. Below is a list of "
"the additions and their default values on install. The settings can be "
"modified in `config.json`, or the System Console when available."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6311
msgid ""
"Added ``ExperimentalDataPrefetch``, to enable messages in all unread "
"channels to be pre-loaded from the server whenever the client reconnects "
"to the network to eliminate loading time when users switch to unread "
"channels."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6313
msgid ""
"Added ``EnableExperimentalGossipEncryption``, to enable all communication"
" through the cluster using the gossip protocol to be encrypted."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6315
msgid "Added ``EnableSentry``, to enable sentry reporting."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6316
msgid ""
"Added ``AdvancedLoggingConfig``, to enable optional logging capability to"
" allow sending log records to a number of destinations."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6318
msgid ""
"Added ``AmazonS3PathPrefix``, to allow using the same S3 bucket for "
"multiple deployments."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6320
msgid ""
"Added ``PushNotificationBuffer``, to remove hardcoded goroutine workers "
"from push notifications to improve notifications arriving in order."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6322
msgid ""
"Added ``EnableAskCommunityLink``, to enable showing a link in the "
"Mattermost channel header under the **Help** menu. When clicked, users "
"are redirected to https://mattermost.com/community/, where they can join "
"the Mattermost Community to ask questions and help others troubleshoot "
"issues. This option is not available on the mobile apps."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6324
msgid ""
"Added ``SMTPServerTimeout``, to ensure Global Relay SMTP connection "
"timeout is independent of regular email settings timeout."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6327
msgid ""
"Added ``react-native-cookies`` and ``react-native-keyboard-aware-scroll-"
"view``, and removed ``@react-native-community/cookies`` in "
"https://github.com/mattermost/mattermost-mobile."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6328
msgid ""
"Added ``dynamic-virtualized-list`` and ``prettier`` in "
"https://github.com/mattermost/mattermost-webapp."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6329
msgid "Added ``rudder-sdk-js`` in https://github.com/mattermost/mattermost-redux."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6332
msgid "Added a new column ``Sessions.ExpiredNotify``."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6335
msgid ""
"Added ``POST api/v4/bots/:bot_id/convert_to_user`` API endpoint to add "
"the ability to convert a bot into a user."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6336
msgid ""
"Added ``POST api/v4/users/:user_id/convert_to_bot`` API endpoint to add "
"the ability to convert a user into a bot."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6337
msgid ""
"Added ``GET api/v4/users/:user_id/teams/:team_id/channels/categories`` "
"API endpoint to get a list of sidebar categories that will appear in the "
"user's sidebar on the given team, including a list of channel IDs in each"
" category."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6338
msgid ""
"Added ``POST api/v4/users/:user_id/teams/:team_id/channels/categories`` "
"API endpoint to create a custom sidebar category for the user on the "
"given team."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6339
msgid ""
"Added ``PUT api/v4/users/:user_id/teams/:team_id/channels/categories`` "
"API endpoint to update any number of sidebar categories for the user on "
"the given team."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6340
msgid ""
"Added ``GET "
"api/v4/users/:user_id/teams/:team_id/channels/categories/order`` API "
"endpoint to get the order of the sidebar categories for a user on the "
"given team as an array of IDs."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6341
msgid ""
"Added ``PUT "
"api/v4/users/:user_id/teams/:team_id/channels/categories/order`` API "
"endpoint to update the order of the sidebar categories for a user on the "
"given team."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6342
msgid ""
"Added ``GET "
"api/v4/users/:user_id/teams/:team_id/channels/categories/:category_id`` "
"API endpoint to get a single sidebar category for the user on the given "
"team."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6343
msgid ""
"Added ``PUT "
"api/v4/users/:user_id/teams/:team_id/channels/categories/:category_id`` "
"API endpoint to update a single sidebar category for the user on the "
"given team."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6344
msgid ""
"Added ``DELETE "
"api/v4/users/:user_id/teams/:team_id/channels/categories/:category_id`` "
"API endpoint to delete a single custom sidebar category for the user on "
"the given team."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6345
msgid ""
"Added ``POST api/v4/ldap/migrateid`` API endpoint to migrate LDAP "
"IdAttribute to a new value."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6346
msgid ""
"Added ``GET api/v4/warn_metrics/status`` API endpoint to get the status "
"of a set of metrics (enabled or disabled) from the Systems table."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6347
msgid ""
"Added ``POST api/v4/warn_metrics/ack/:warn_metric_id`` API endpoint to "
"acknowldge a warning for the ``warn_metric_id`` metric crossing a "
"threshold (or some similar condition being fulfilled)."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6348
msgid ""
"Added ``GET api/v4/groups/:group_id/stats`` API endpoint to retrieve the "
"stats of a given group."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6349
msgid ""
"Added ``GET api/v4/teams/:team_id/channels/private`` API endpoint to get "
"a list of private channels on a team based on query string parameters."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6350
msgid ""
"Added ``GET api/v4/users/stats/filtered`` API endpoint to get a count of "
"users in the system matching the specified filters."
msgstr ""

#: ../../source/product-overview/unsupported-legacy-releases.md:6351
msgid ""
"Added ``POST api/v4/users/:user_id/email/verify/member`` API endpoint to "
"verify the email used by a user without a token."
