msgstr ""

#: ../../source/product-overview/mattermost-v10-changelog.md:1508
msgid ""
"User APIs now enforce username beginning with alphabetic character, "
"matching client-side validation."
msgstr ""

#: ../../source/product-overview/mattermost-v10-changelog.md:1509
msgid ""
"Added a new request parameter ``include_total_count`` to API endpoint "
"``GET /api/v4/hooks/incoming``."
