#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:553
msgid "TURN static auth secret"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:556
msgid "A static secret used to generate short-lived credentials for TURN servers."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:559
msgid "This is an optional field."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:557
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``turnstaticauthsecret``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:558
msgid "Environment variable: ``MM_CALLS_TURN_STATIC_AUTH_SECRET``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:574
msgid "TURN credentials expiration"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:577
msgid ""
"The expiration, in minutes, of the short-lived credentials generated for "
"TURN servers."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:581
msgid "Default is **1440** (one day)."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:578
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``turncredentialsexpirationminutes``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:579
msgid "Environment variable: ``MM_CALLS_TURN_CREDENTIALS_EXPIRATION_MINUTES``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:598
msgid "Server side TURN"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:601
msgid ""
"**true**: The RTC server will use the configured TURN candidates for "
"server-initiated connections."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:602
msgid "**false**: TURN will be used only on the client-side."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:602
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``serversideturn``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:603
msgid "Environment variable: ``MM_CALLS_SERVER_SIDE_TURN``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:622
msgid "Allow screen sharing"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:625
msgid "**true**: Call participants will be allowed to share their screen."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:626
msgid "**false**: Call participants won't be allowed to share their screen."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:626
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``allowscreensharing``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:627
msgid "Environment variable: ``MM_CALLS_ALLOW_SCREEN_SHARING``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:645
msgid "Enable simulcast for screen sharing (Experimental)"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:648
msgid ""
"**true**: Enables simulcast for screen sharing. This can help to improve "
"screen sharing quality."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:649
msgid "**false**: Disables simulcast for screen sharing."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:649
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``enablesimulcast``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:650
msgid "Environment variable: ``MM_CALLS_ENABLE_SIMULCAST``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:655
msgid "This experimental setting is applicable only to self-hosted deployments."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:656
msgid ""
"This functionality requires Calls plugin version >= v0.16.0 and ``rtcd`` "
"version >= v0.10.0 (when in use)."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:657
msgid ""
"Avoid enabling both this experimental configuration setting and the "
"`Enable AV1 <#enable-av1-experimental>`__ experimental configuration "
"setting at the same time."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:669
msgid "Enable call recordings"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:675
msgid "**true**: Allows call hosts to record meeting video and audio."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:676
msgid ""
"**false**: **(Default)** Call recording functionality is not available to"
" hosts."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:678
msgid ""
"Recordings include the entire call window view along with participants' "
"audio track and any shared screen video. Recordings are stored in "
"Mattermost."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:676
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``enablerecordings``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:677
msgid "Environment variable: ``MM_CALLS_ENABLE_RECORDINGS``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:695
msgid "Job service URL"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:701
msgid ""
"The URL to a running job service where all the processing related to "
"recordings happens. The recorded files produced are stored in Mattermost."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:703
msgid ""
"This is a required field. Changing this setting requires a plugin restart"
" to take effect."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:702
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``jobserviceurl``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:703
msgid "Environment variable: ``MM_CALLS_JOB_SERVICE_URL``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:710
msgid ""
"The service URL supports credentials in the form "
"``http://clientID:authKey@hostname``. Alternatively these can be passed "
"through environment overrides to the Mattermost server, namely "
"``MM_CALLS_JOB_SERVICE_CLIENT_ID`` and ``MM_CALLS_JOB_SERVICE_AUTH_KEY``."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:712
msgid ""
"As of Calls v0.25 it's possible to override the site URL used by jobs to "
"connect by setting the ``MM_CALLS_RECORDER_SITE_URL`` or "
"``MM_CALLS_TRANSCRIBER_SITE_URL`` environment variables respectively. "
"This can be helpful to avoid the jobs from connecting through the public "
"Site URL configured in Mattermost and thus potentially bypass the public "
"network."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:723
msgid "Maximum call recording duration"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:729
msgid "The maximum duration of a call recording in minutes."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:732
msgid "The default is **60**. The maximum is **180**. This is a required value."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:730
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``maxrecordingduration``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:731
msgid "Environment variable: ``MM_CALLS_MAX_RECORDING_DURATION``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:747
msgid "Call recording quality"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:753
msgid ""
"The audio and video quality of call recordings. Available options are: "
"*Low*, *Medium* and *High*."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:756
msgid "The default is **Medium**. This is a required value."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:754
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``recordingquality``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:755
msgid "Environment variable: ``MM_CALLS_RECORDING_QUALITY``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:761
msgid ""
"The quality setting will affect the performance of the job service and "
"the file size of recordings. Refer to the :doc:`Calls deployment guide "
"</administration-guide/configure/calls-deployment-guide>` documentation "
"for more information."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:773
msgid "Enable call transcriptions"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:779
msgid "**true**: Enables automatic transcriptions of calls."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:780
msgid "**false**: **(Default)** Call transcriptions functionality is disabled."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:782
msgid ""
"Transcriptions are generated from the call participants' audio tracks and"
" the resulting files are attached to the call thread when the recording "
"ends. Captions will be optionally rendered on top of the recording file "
"video player."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:780
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``enabletranscriptions``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:781
msgid "Environment variable: ``MM_CALLS_ENABLE_TRANSCRIPTIONS``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:787
msgid ""
"The ability to enable call transcriptions in Mattermost calls is "
"currently in :ref:`Beta <administration-guide/manage/feature-"
"labels:beta>`."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:788
msgid ""
"This server-side configuration setting is available from plugin version "
"0.22."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:789
msgid ""
"Call transcriptions require :ref:`call recordings <administration-"
"guide/configure/plugins-configuration-settings:enable call recordings>` "
"to be enabled."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:799
msgid "Transcriber model size"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:805
msgid ""
"The speech-to-text model size to use. Heavier models will produce more "
"accurate results at the expense of processing time and resources usage. "
"Available options are: *Tiny*, *Base* and *Small*."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:808
msgid "The default is **Base**. This is a required value."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:806
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``transcribermodelsize``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:807
msgid "Environment variable: ``MM_CALLS_TRANSCRIBER_MODEL_SIZE``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:813
msgid ""
"This setting is available starting in plugin version 0.22. The model size"
" setting will affect the performance of the job service. Refer to the "
":doc:`Calls deployment guide </administration-guide/configure/calls-"
"deployment-guide>` documentation for more information."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:823
msgid "Call transcriber threads"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:829
msgid ""
"The number of threads used by the post-call transcriber. This must be in "
"the range [1, numCPUs]."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:832
#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:934
msgid "The default is 2. This is a required value."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:830
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``transcribernumthread``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:831
msgid "Environment variable: ``MM_CALLS_TRANSCRIBER_NUM_THREADS``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:837
msgid ""
"The call transcriber threads setting will affect the performance of the "
"job service. Refer to the :doc:`Calls deployment guide </administration-"
"guide/configure/calls-deployment-guide>` documentation for more "
"information. This setting is available starting in plugin version 0.26.2."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:850
msgid "Enable live captions"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:856
msgid "**true**: Enables live captioning of calls."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:857
msgid "**false**: **(Default)** Live captions functionality is disabled."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:859
msgid ""
"Live captions are generated from the call participants' audio tracks and "
"the resulting captions can be optionally displayed on the call clients by"
" selecting the **[cc]** option."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:857
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``enablelivecaptions``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:858
msgid "Environment variable: ``MM_CALLS_ENABLE_LIVE_CAPTIONS``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:865
msgid ""
"The ability to enable live call captions in Mattermost calls is currently"
" in :ref:`Beta <administration-guide/manage/feature-labels:beta>`."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:866
msgid ""
"This server-side configuration setting is available starting in plugin "
"version 0.26.2."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:867
msgid ""
"Live captions require :ref:`call recordings <administration-"
"guide/configure/plugins-configuration-settings:enable call recordings>` "
"and :ref:`call transcriptions <administration-guide/configure/plugins-"
"configuration-settings:enable call transcriptions>` to be enabled."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:877
msgid "Live captions: Model size"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:883
msgid ""
"The speech-to-text model size to use for live captions. While heavier "
"models can produce more accurate results, live captioning requires the "
"transcriber to process up to ten seconds of audio within two seconds. "
"Therefore a maximum of size `base` is recommended. Available options are:"
" *Tiny*, *Base* and *Small*."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:886
msgid "The default is **Tiny**. This is a required value."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:884
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``livecaptionsmodelsize``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:885
msgid "Environment variable: ``MM_CALLS_LIVE_CAPTIONS_MODEL_SIZE``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:891
msgid ""
"This setting is available starting in plugin version 0.26.2. The model "
"size setting will affect the performance of the job service. Refer to the"
" `performance and scalability recommendations "
"<https://github.com/mattermost/calls-"
"offloader/blob/master/docs/performance.md>`_ documentation for more "
"information."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:901
msgid "Live captions: Number of transcribers used per call"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:907
msgid ""
"The number of separate live captions transcribers for each call. Each "
"transcribes one audio stream at a time. The product of "
"LiveCaptionsNumTranscribers * LiveCaptionsNumThreadsPerTranscriber must "
"be in the range [1, numCPUs]."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:910
msgid "The default is 1. This is a required value."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:908
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``livecaptionsnumtranscribers``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:909
msgid "Environment variable: ``MM_CALLS_LIVE_CAPTIONS_NUM_TRANSCRIBERS``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:915
msgid ""
"This setting is available starting in plugin version 0.26.2. The live "
"captions number of transcribers setting will affect the performance of "
"the job service. Refer to the `performance and scalability "
"recommendations <https://github.com/mattermost/calls-"
"offloader/blob/master/docs/performance.md>`_ documentation for more "
"information."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:925
msgid "Live captions: Number of threads per transcriber"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:931
msgid ""
"The number of threads per live-captions transcriber. The product of "
"``LiveCaptionsNumTranscribers`` * "
"``LiveCaptionsNumThreadsPerTranscriber`` must be in the range [1, "
"numCPUs]."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:932
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``livecaptionsnumthreadspertranscriber``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:933
msgid ""
"Environment variable: "
"``MM_CALLS_LIVE_CAPTIONS_NUM_THREADS_PER_TRANSCRIBER``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:939
msgid ""
"This setting is available starting in plugin version 0.26.2. The live "
"captions number of threads per transcriber setting will affect the "
"performance of the job service. Refer to the `performance and scalability"
" recommendations <https://github.com/mattermost/calls-"
"offloader/blob/master/docs/performance.md>`_ documentation for more "
"information"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:949
msgid "Live captions language"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:955
msgid ""
"The language passed to the live captions transcriber. Should be a "
"2-letter ISO 639 Set 1 language code, e.g. 'en'."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:958
msgid "If blank, the lange will be set to 'en' (English) as default."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:956
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``livecaptionslanguage``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:957
msgid "Environment variable: ``MM_CALLS_LIVE_CAPTIONS_LANGUAGE``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:974
msgid "(Experimental) Enable IPv6"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:977
msgid ""
"**true**: The RTC service will work in dual-stack mode, listening for "
"IPv6 connections and generating candidates in addition to IPv4 ones."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:978
msgid ""
"**false**: **(Default)** The RTC service will only listen for IPv4 "
"connections."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:978
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``enableipv6``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:979
msgid "Environment variable: ``MM_CALLS_ENABLE_IPV6``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:985
msgid ""
"This setting is available starting in plugin version 0.17, and is only "
"applicable when not running calls through the standalone ``rtcd`` "
"service."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:997
msgid "Enable call ringing"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1000
msgid ""
"**true**: Ringing functionality is enabled. Direct and group message "
"participants receive a desktop app alert and a ringing notification when "
"a call starts."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1003
msgid "**false**: **(Default**) Ringing functionality is disabled."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1001
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``enableringing``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1002
msgid "Environment variable: ``MM_CALLS_ENABLE_RINGING``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1008
msgid ""
"The ability to enable call ringing in Mattermost calls is in :ref:`Beta "
"<administration-guide/manage/feature-labels:beta>`."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1021
msgid "Enable AV1 (Experimental)"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1023
msgid ""
"**true**: Enables the ability to use the AV1 codec to encode screen "
"sharing tracks. Can result in improved screen sharing quality via clients"
" that support AV1 encoding."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1026
msgid "**false**: **(Default**) AV1 codec is disabled for screen sharing tracks."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1024
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``enableAV1``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1025
msgid "Environment variable: ``MM_CALLS_ENABLE_AV1``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1032
msgid ""
"Avoid enabling both this experimental configuration setting and the "
"`Enable simulcast for screen sharing <#enable-simulcast-for-screen-"
"sharing-experimental>`__ experimental configuration setting at the same "
"time."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1044
msgid "Enable DC signaling (Experimental)"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1047
msgid ""
"**true**: Clients will use WebRTC data channels for signaling of media "
"tracks (i.e., voice, screen). This can result in a more efficient and "
"less race-prone process, especially in case of poor network connections."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1050
msgid ""
"**false**: **(Default**) Clients will use WebSockets for signaling media "
"tracks."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1048
msgid ""
"``config.json`` setting: ``PluginSettings`` > ``Plugins`` > "
"``com.mattermost.calls`` > ``enabledcsignaling``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1049
msgid "Environment variable: ``MM_CALLS_ENABLE_DC_SIGNALING``"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1056
msgid ""
"Version v0.18.0 or higher of the |rtcd_service| is required for this "
"functionality to work when hosting calls through the dedicated WebRTC "
"service."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1057
msgid ""
"Use caution when enabling this experimental configuration setting since "
"it determines how the system handles part of the setup for WebRTC-based "
"calls. Enabling this configuration setting may make the call setup a bit "
"faster or more reliable in certain situations."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1062
msgid "AI Agents"
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1066
msgid "Mattermost Agents is formerly known as Mattermost Copilot."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1068
msgid ""
"Access the following Mattermost Agents configuration settings in the "
"System Console by going to **Plugins > Agents**."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1083
msgid "**true**: Enables the Agents plugin on your Mattermost workspace."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1084
msgid "**false**: **(Default)** Disables the Agents plugin."
msgstr ""

#: ../../source/administration-guide/configure/plugins-configuration-settings.rst:1083
msgid "System Config path: **Plugins > Agents**"
msgstr ""

