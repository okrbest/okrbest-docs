#: ../../source/administration-guide/configure/site-configuration-settings.rst:1687
msgid ""
"``config.json`` setting: ``ServiceSettings`` > "
"``PersistentNotificationIntervalMinutes`` > ``5``"
msgstr ""

#: ../../source/administration-guide/configure/site-configuration-settings.rst:1688
msgid ""
"Environment variable: "
"``MM_SERVICESETTINGS_PERSISTENTNOTIFICATIONINTERVALMINUTES``"
msgstr ""

#: ../../source/administration-guide/configure/site-configuration-settings.rst:1700
msgid "Total number of persistent notifications per post"
msgstr ""

#: ../../source/administration-guide/configure/site-configuration-settings.rst:1703
msgid "The maximum number of times users may receive persistent notifications."
