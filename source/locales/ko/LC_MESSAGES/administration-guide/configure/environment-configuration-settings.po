msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:723
msgid ""
"``postgres://mmuser:password@hostname_or_IP:5432/mattermost_test ?sslmode"
"=verify-full&connect_timeout=10``"
