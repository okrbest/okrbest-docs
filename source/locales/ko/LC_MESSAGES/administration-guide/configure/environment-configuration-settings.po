#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4127
msgid "Environment variable: ``MM_METRICSSETTINGS_BLOCKPROFILERATE``"
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4138
msgid ""
"This setting isn't available in the System Console and can only be set in"
" ``config.json``."
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4139
msgid ""
"Only adjust this if you’re diagnosing performance issues and know how to "
"analyze profiling data. The value represents how frequently Mattermost "
"records blocking events in its performance profile:"
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4141
msgid "Set to 0 to record no blocking events (profiling is disabled)."
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4142
msgid "Set to 1 to record every blocking event (profiling is fully enabled)."
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4143
msgid ""
"Set to a higher number to record only a fraction of events (useful for "
"sampling instead of full profiling)."
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4153
