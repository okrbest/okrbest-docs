msgstr "신뢰할 수 있는 서버에 연결할 때 데이터가 암호화됩니다."

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:720
msgid "``verify-ca``"
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:720
msgid ""
"``postgres://mmuser:password@hostname_or_IP:5432/mattermost_test ?sslmode"
"=verify-ca&connect_timeout=10``"
msgstr ""

