"**false**: **(Default for Cloud deployments)** All communication using "
"the gossip protocol remains uncompressed."
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:2908
msgid ""
"``config.json`` setting: ``ClusterSettings`` > "
"``EnableGossipCompression`` > ``true``"
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:2909
