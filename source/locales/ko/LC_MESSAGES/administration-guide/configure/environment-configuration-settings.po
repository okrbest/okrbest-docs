#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4196
msgid ""
"``config.json`` setting: ``ServiceSettings`` > ``EnableTesting`` > "
"``true``"
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4197
msgid "Environment variable: ``MM_SERVICESETTINGS_ENABLETESTING``"
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4217
msgid "Enable developer mode"
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4220
msgid "Enable or disable developer mode."
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4222
msgid ""
"**true**: **(Default)** Javascript errors are shown in a banner at the "
"top of Mattermost the user interface. Not recommended for use in "
"production."
msgstr ""

#: ../../source/administration-guide/configure/environment-configuration-settings.rst:4226
