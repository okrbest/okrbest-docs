#: ../../source/_generated/agents/docs/admin_guide.md:653
msgid "Valid authentication method (OAuth or Personal Access Token)"
msgstr ""

#: ../../source/_generated/agents/docs/admin_guide.md:655
msgid ""
"**Note:** The server uses streamable HTTP transport and does not support "
"traditional Server-Sent Events (SSE) transport. External clients must use"
" the streamable HTTP transport available at the `/mcp` endpoint."
msgstr ""

#: ../../source/_generated/agents/docs/admin_guide.md:657
msgid "To enable an external MCP client:"
msgstr ""

