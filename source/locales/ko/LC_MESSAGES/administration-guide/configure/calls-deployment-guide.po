#: ../../source/administration-guide/configure/calls-deployment-guide.md:55
msgid ""
"[**Install and Configure Recording**](#phase-3-install-and-configure-"
"recording) (Optional)"
msgstr ""

#: ../../source/administration-guide/configure/calls-deployment-guide.md:57
msgid ""
"Calls Offloader is a service required to deliver recording, transcription"
