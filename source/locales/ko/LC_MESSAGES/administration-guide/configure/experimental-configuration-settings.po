#: ../../source/administration-guide/configure/experimental-configuration-settings.rst:516
msgid "SAML login button border color"
msgstr ""

#: ../../source/administration-guide/configure/experimental-configuration-settings.rst:518
msgid ""
"Specify the color of the SAML login button border for white labeling "
