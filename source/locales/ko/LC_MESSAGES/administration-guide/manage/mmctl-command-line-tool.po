#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7441
msgid "mmctl user migrate-auth"
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7445
msgid ""
"Migrate accounts from one authentication provider to another. For "
"example, you can upgrade your authentication provider from email to LDAP."
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7453
msgid "**Arguments**"
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7455
msgid "**from_auth:**"
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7456
msgid ""
"The authentication service to migrate users accounts from. Supported "
"options: email, gitlab, google, ldap, office365, saml."
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7459
msgid "**to_auth:**"
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7460
msgid ""
"The authentication service to migrate users to. Supported options: ldap, "
"saml."
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7463
msgid "**migration-options (ldap):**"
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7464
msgid "match_field:"
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7465
msgid ""
"The field that is guaranteed to be the same in both authentication "
"services. For example, if the users emails are consistent set to email. "
"Supported options: email, username."
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7468
msgid "**migration-options (saml):**"
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7469
msgid "**users_file:**"
msgstr ""

#: ../../source/administration-guide/manage/mmctl-command-line-tool.rst:7470
msgid ""
"The path of a json file with the usernames and emails of all users to "
"migrate to SAML. The username and email must be the same that the SAML "
"service provider store. And the email must match with the email in "
"mattermost database."
msgstr ""

