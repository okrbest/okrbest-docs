msgstr ""

#: ../../source/administration-guide/onboard/sso-saml-onelogin.rst:65
msgid "First Name"
msgstr ""

#: ../../source/administration-guide/onboard/sso-saml-onelogin.rst:67
msgid "LastName"
msgstr ""

#: ../../source/administration-guide/onboard/sso-saml-onelogin.rst:67
