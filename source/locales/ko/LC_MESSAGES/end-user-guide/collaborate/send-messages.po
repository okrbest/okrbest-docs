msgid ":doc:`Share files </end-user-guide/collaborate/share-files-in-messages>`"
msgstr ":doc:`파일 공유 </end-user-guide/collaborate/share-files-in-messages>`"

#: ../../source/end-user-guide/collaborate/send-messages.rst:217
msgid ""
":doc:`Share links to channels and messages </end-user-guide/collaborate"
"/share-links>`"
msgstr ""
":doc:`채널 및 메시지 링크 공유 </end-user-guide/collaborate/share-links>`"

