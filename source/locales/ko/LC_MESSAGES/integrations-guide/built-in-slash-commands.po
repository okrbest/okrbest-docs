"Echo text back to yourself using ``/echo {message} {delay in seconds}`` "
"or ``/me {message}``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:44
#, python-brace-format
msgid "Respond with a shrug using ``/shrug {message}``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:45
#, python-brace-format
msgid "Search message text using ``search {text}``."
msgstr ""

