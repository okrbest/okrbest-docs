#: ../../source/integrations-guide/built-in-slash-commands.rst:14
msgid "Invite people"
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:16
msgid "Invite one person using ``/invite user1`` or ``/invite @user1``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:17
msgid "Invite a custom user group using ``/invite @usergroup``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:18
msgid "Invite multiple people using ``/invite @user1 @user2``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:19
msgid ""
"Invite one person to a specific channel using ``/invite @user1 "
"~channel1``, or ``/invite @user1 channel1``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:20
msgid ""
"Invite multiple people to multiple channels using ``/invite @user1 @user2"
" ~channel1 ~channel2``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:21
#, python-brace-format
msgid "Invite people by email using ``/invite_people {name@domain.com, ...}``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:24
msgid "Join, leave, or mute channels"
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:26
#, python-brace-format
msgid ""
"Join a specific channel using ``/join {channel-name}`` or ``/open "
"{channel-name}``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:27
msgid "Leave a channel using ``/leave``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:28
#, python-brace-format
msgid ""
"Mute a channel using ``/mute`` or ``/mute {channel-name}`` to turn off "
"desktop, email, and push notifications for the current or specified "
"channel."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:29
#, python-brace-format
msgid ""
"Remove someone from a channel using ``/kick {@username}`` or ``/remove "
"{@username}``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:32
msgid "Start or join a call"
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:34
msgid "Start a call in a channe or thread using ``/call start``"
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:35
msgid "Join a call in a channel or thread using ``/call join``"
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:38
msgid "Manage conversations"
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:40
#, python-brace-format
msgid ""
"Send a direct message to someone using ``/msg {@username} {message}``, or"
" send a group message to multiple people using ``/groupmsg {@username1, "
"@username2, @username3,...} {message}``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:41
#, python-brace-format
msgid "Display text as a code block using ``/code {text}``."
msgstr ""

#: ../../source/integrations-guide/built-in-slash-commands.rst:42
