msgstr ""

#: ../../source/integrations-guide/servicenow.rst:75
msgid "``kb_knowledge``"
msgstr ""

#: ../../source/integrations-guide/servicenow.rst:76
msgid "``task``"
msgstr ""

#: ../../source/integrations-guide/servicenow.rst:77
msgid "``change_task``"
msgstr ""

#: ../../source/integrations-guide/servicenow.rst:78
msgid "``cert_follow_on_task``"
msgstr ""

#: ../../source/integrations-guide/servicenow.rst:79
msgid "``x_830655_mm_std_servicenow_for_mattermost_notifications_auth``"
msgstr ""

